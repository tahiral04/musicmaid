#compdef musicmaid

_musicmaid() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message and exit]' \
    '(-a --lossy)'{-a,--lossy}'[LOSSY conversions]' \
    '(-f --lossless)'{-f,--lossless}'[LOSSLESS conversions]' \
    '(-A --cp-lossy)'{-A,--cp-lossy}'[Copy or move files to lossy-dir]' \
    '(-F --cp-lossless)'{-F,--cp-lossless}'[Copy or move files to lossless-dir]' \
    '(-c --cover)'{-c,--cover}'[Process cover images]' \
    '(-r --rip -m --rip-multi)'{-r,--rip}'[Rip CD]' \
    '(-r --rip -m --rip-multi)'{-m,--rip-multi}'[Rip multiple CDs]' \
    '(-v --keep-va)'{-v,--keep-va}'[Prevent renaming "Various Artists" to "Compilations"]' \
    '(-e --env)'{-e,--env}'[Output default encoders configuration to ~/.config/musicmaid.env]' \
    ':source directory:_files -/' \
    '::lossy directory:_files -/' \
    '::lossless directory:_files -/'
}

_musicmaid "$@"
