#compdef musicmaid

_musicmaid() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help message and exit]' \
    '(-r --rip)'{-r,--rip}'[Rip CD before any other operation]' \
    '(-c --cover)'{-c,--cover}'[Process cover images]' \
    '(-v --keep-va)'{-v,--keep-va}'[Prevent renaming "Various Artists" to "Compilations"]' \
    '(-i --ipod)'{-i,--ipod}'[Skip AAC conversions]' \
    '(-f --flac)'{-f,--flac}'[Skip FLAC conversions]' \
    '--cp-ipod[Do not copy or move files to ipod-dir]' \
    '--cp-flac[Do not copy or move files to flac-dir]' \
    '*:directories:_files -/'
}

_musicmaid "$@"