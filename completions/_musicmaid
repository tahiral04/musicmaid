#compdef musicmaid

_musicmaid() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message and exit]' \
    '(-r --rip -m --rip-multi)'{-r,--rip}'[Rip CD]' \
    '(-r --rip -m --rip-multi)'{-m,--rip-multi}'[Rip multiple CDs]' \
    '(-c --cover)'{-c,--cover}'[Process cover images]' \
    '(-v --keep-va)'{-v,--keep-va}'[Prevent renaming "Various Artists" to "Compilations"]' \
    '(-i --ipod)'{-i,--ipod}'[Skip AAC conversions]' \
    '(-f --flac)'{-f,--flac}'[Skip FLAC conversions]' \
    '(-p --cp-ipod)'{-p,--cp-ipod}'[Do not copy or move files to ipod-dir]' \
    '(-l --cp-flac)'{-l,--cp-flac}'[Do not copy or move files to flac-dir]' \
    ':source directory:_files -/' \
    '::ipod directory:_files -/' \
    '::flac directory:_files -/'
}

_musicmaid "$@"
