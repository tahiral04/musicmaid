#!/bin/sh

# =========================
# ====  CONFIGURATION  ====
# =========================

# --- COLORS ---
# set the ANSI escape mode to color the output on the terminal. See link below:
# https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#color-codes
COLOR_RESET='\033[0m'    # reset mode
COLOR_SUCCESS='\033[32m' # green
COLOR_INFO='\033[33m'    # yellow
COLOR_ERROR='\033[31m'   # red

# --- ENCODERS ---
AAC_ENCODER_PATH="$HOME/.wine/drive_c/qaac/qaac.exe"
AAC_ENCODER_OPTIONS="--tvbr 100 --quality 2 --gapless-mode 2"
AAC_ENCODER_USE_WINE=0
AAC_ENCODER_WINE="WINEDEBUG=-all wine"
FFMPEG_PATH="ffmpeg"
FFMPEG_GLOBAL_OPTIONS="-hide_banner -y"

# --- OPTIONS ---
THREAD_NUM=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
CONV_IPOD=1
CONV_FLAC=1
CP_IPOD=1
CP_FLAC=1
RIP_CD=0
RIP_FOLDER="mm_cd_rip"
ABCDE_CONF_FILE=""
KEEP_VA=0
COVER_PROCESS=0
COVER_CONVERT_QUALITY=85
COVER_DIM="1500x1500"
COVER_DIM_IPOD="200x200"

# --- DIRECTORIES ---
SRC_DIR=""
IPOD_DIR=""
FLAC_DIR=""

# ===================
# ===  FUNCTIONS  ===
# ===================

main() {
  check_dependencies
  parse_arguments "$@"
  [ "$RIP_CD" -eq 1 ] && { rip_cd; printf '\n'; }
  [ "$CONV_IPOD" -eq 1 ] || [ "$CONV_FLAC" -eq 1 ] || [ "$CP_FLAC" -eq 1 ] || [ "$CP_IPOD" -eq 1 ] || [ "$COVER_PROCESS" -eq 1 ] && log_info "Scanning directory..."
  [ "$CONV_IPOD" -eq 1 ] && { convert_ipod; printf '\n'; }
  [ "$CONV_FLAC" -eq 1 ] && { convert_flac; printf '\n'; }
  [ "$CP_IPOD" -eq 1 ] || [ "$CP_FLAC" -eq 1 ] && { copy_files; printf '\n'; }
  [ "$COVER_PROCESS" -eq 1 ] && { cover_processor; printf '\n'; }
  log_success "All done!"
}

log_standard() {
  color="$1"
  shift
  printf '%b%s%b' "$color" "$1" "$COLOR_RESET"
  shift
  [ "$#" -gt 0 ] && printf ' %s' "$@"; printf '\n'
}

log_success() { log_standard "$COLOR_SUCCESS" "$@"; }

log_info() { log_standard "$COLOR_INFO" "$@"; }

log_error() { { log_standard "$COLOR_ERROR" "$@"; } >&2; }

cleanup_tmp_files() { rm -f /tmp/mm_abcde.* /tmp/mm_cover.* || true; }

print_help() {
  cat <<EOF
Shell script for managing audio files. It can rip CDs, convert WAV to FLAC,
convert WAV/FLAC to AAC, copy or move files, and process cover images into
an 'artist/album' directory structure.

Usage:
  $(basename "$0") [options] src-dir SRC ipod-dir IPOD_DIR flac-dir FLAC_DIR

  src-dir        Source directory. Can be omitted when 'no-ipod', 'no-flac',
                 'no-copy-ipod', 'no-copy-flac' are set and 'rip' or 'cover'
                 are not used
  ipod-dir       Destination directory for AAC files. Defaults to SRC if
                 not provided or 'no-copy-ipod' is set
  flac-dir       Destination directory for FLAC files. Defaults to SRC if
                 not provided or 'no-copy-flac' is set

Options:
  help           Show this help message and exit
  no-ipod        Skip AAC conversions
  no-flac        Skip FLAC conversions
  no-copy-ipod   Don't copy or move files to IPOD_DIR
  no-copy-flac   Don't copy or move files to FLAC_DIR
  rip            Rip CD into "SRC/$RIP_FOLDER" before any other operation
  keep-va        Prevent renaming "Various Artists" folder to "Compilations"
  cover          Scan SRC for cover images (cover.png/jpg/jpeg), generate a
                 200x200 "cover_ipod.jpg", resize originals larger than
                 1500x1500, convert PNGs to JPG, recompress JPGs above
                 1 MiB, and strip all metadata. The processed files replace
                 the originals

Dependencies:
  GNU Parallel   Parallel file conversion
  abcde          CD ripper
  ffmpeg         FLAC encoder
  qaac           AAC encoder
  ImageMagick    Cover image processing
EOF
}

parse_arguments() {
  [ "$#" -eq 0 ] && { log_error "Error: too few arguments"; print_help; exit 1; }
  while [ "$#" -gt 0 ]; do
    case "$1" in
      help) print_help; exit 0 ;;
      no-ipod) CONV_IPOD=0 ;;
      no-flac) CONV_FLAC=0 ;;
      no-copy-ipod) CP_IPOD=0 ;;
      no-copy-flac) CP_FLAC=0 ;;
      rip) RIP_CD=1 ;;
      keep-va) KEEP_VA=1 ;;
      cover) COVER_PROCESS=1 ;;
      src-dir|ipod-dir|flac-dir)
        var_name=$(echo "$1" | tr '-' '_' | tr '[:lower:]' '[:upper:]')
        [ -z "$(eval echo \$$var_name)" ] && { shift; eval "$var_name"='"$1"'; }
        ;;
      *) log_error "Error: unknown option $1"; exit 1 ;;
    esac
    shift
  done

  # check SRC and DEST are valid (see help text)
  if [ "$CONV_IPOD" -eq 1 ] || [ "$CONV_FLAC" -eq 1 ] || [ "$CP_IPOD" -eq 1 ] || [ "$CP_FLAC" -eq 1 ] \
  || [ "$RIP_CD" -eq 1 ] || [ "$COVER_PROCESS" -eq 1 ] && { [ -z "$SRC_DIR" ] || [ ! -d "$SRC_DIR" ]; }; then
    log_error "Error: missing or invalid source directory"
    exit 1
  fi
  SRC_DIR=$(realpath "$SRC_DIR")/

  IPOD_DIR=${IPOD_DIR:-$SRC_DIR}
  if [ "$CP_IPOD" -eq 1 ] && [ ! -d "$IPOD_DIR" ]; then
    log_error "Error: missing or invalid destination directory for ipod files"
    exit 1
  fi
  IPOD_DIR=$(realpath "$IPOD_DIR")/

  FLAC_DIR=${FLAC_DIR:-$SRC_DIR}
  if [ "$CP_FLAC" -eq 1 ] && [ ! -d "$FLAC_DIR" ]; then
    log_error "Error: missing or invalid destination directory for FLAC files"
    exit 1
  fi
  FLAC_DIR=$(realpath "$FLAC_DIR")/
}

check_dependencies() {
  missing_dep=0
  for cmd in parallel abcde ffmpeg magick; do
    command -v "$cmd" >/dev/null 2>&1 || { log_error "Error: $cmd is not installed"; missing_dep=1; }
  done

  if [ -z "$AAC_ENCODER_PATH" ]; then
    log_error "Error: AAC_ENCODER_PATH is empty"
    missing_dep=1
  elif [ -e "$AAC_ENCODER_PATH" ]; then
    # check if AAC_ENCODER_PATH is a windows executable
    if head -c 2 "$AAC_ENCODER_PATH" 2>/dev/null | grep -q '^MZ'; then
      command -v wine >/dev/null 2>&1 || { log_error "Error: wine is required by the AAC encoder but is not installed"; missing_dep=1; }
      AAC_ENCODER_USE_WINE=1
    elif [ ! -x "$AAC_ENCODER_PATH" ]; then
      log_error "Error: AAC encoder at \"$AAC_ENCODER_PATH\" is not executable"
      missing_dep=1
    fi
  elif ! command -v "$AAC_ENCODER_PATH" >/dev/null 2>&1; then
    log_error "Error: $AAC_ENCODER_PATH can't be found or executed"
    missing_dep=1
  fi

  [ "$missing_dep" -eq 1 ] && exit 1
}

get_target_path() {
  # Returns target directory in 'artist/album' format.
  # Usage: target_path=$(get_target_path "file" "base_directory")

  artist=$(basename "$(dirname "$(dirname "$1")")")
  [ "$KEEP_VA" -eq 0 ] && [ "$(echo "$artist" | tr '[:upper:]' '[:lower:]')" = "various artists" ] && artist="Compilations"
  album=$(basename "$(dirname "$1")")

  target="$2"
  [ "$artist" != "." ] && [ "$artist" != "/" ] && target="$target$artist/"
  [ "$album" != "." ] && [ "$album" != "/" ] && target="$target$album/"

  printf '%s' "$target"
}

convert_ipod() {
  export COLOR_INFO COLOR_RESET AAC_ENCODER_PATH AAC_ENCODER_OPTIONS AAC_ENCODER_USE_WINE AAC_ENCODER_WINE

  find "$SRC_DIR" \( -iname "*.wav" -o -iname "*.flac" \) -type f \
  | while IFS= read -r file; do
    [ -e "${file%.*}.m4a" ] && continue
    target_path=$(get_target_path "$file" "$IPOD_DIR")
    mkdir -p "$target_path"
    printf '%s\0%s\0' "$target_path" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    dest_dir={1}
    file={2}
    printf '%b' "${COLOR_INFO}Converting${COLOR_RESET} \"$file\"\n"
    if [ "$AAC_ENCODER_USE_WINE" -eq 1 ]; then
      '"$AAC_ENCODER_WINE"' "$AAC_ENCODER_PATH" '"$AAC_ENCODER_OPTIONS"' -d "$dest_dir" "$file"
    else
      "$AAC_ENCODER_PATH" '"$AAC_ENCODER_OPTIONS"' -d "$dest_dir" "$file"
    fi
  '
}

convert_flac() {
  export COLOR_INFO COLOR_RESET FFMPEG_PATH FFMPEG_GLOBAL_OPTIONS

  find "$SRC_DIR" -iname "*.wav" -type f \
  | while IFS= read -r file; do
    [ -e "${file%.*}.flac" ] && continue
    target_path=$(get_target_path "$file" "$FLAC_DIR")
    mkdir -p "$target_path"
    printf '%s\0%s\0' "$target_path$(basename "$file" .wav).flac" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    dest_dir={1}
    file={2}
    printf '%b' "${COLOR_INFO}Converting${COLOR_RESET} \"$file\"\n"
    "$FFMPEG_PATH" '"$FFMPEG_GLOBAL_OPTIONS"' -i "$file" -c:a flac -compression_level 12 "$dest_dir"
  '
}

copy_files() {
  find "$SRC_DIR" \( -iname "*.m4a" -o -iname "*.mp3" -o -iname "*.flac" \) -type f \
  | while IFS= read -r file; do
    case "${file##*.}" in
      m4a|mp3)
        if [ "$CP_IPOD" -eq 1 ] && { [ -e "${file%.*}.wav" ] || [ -e "${file%.*}.flac" ]; }; then
          target_path=$(get_target_path "$file" "$IPOD_DIR")
          mkdir -p "$target_path"
          log_info "Moving ipod" "\"$file\" -> \"$target_path\""
          mv --update "$file" "$target_path"
          continue
        fi
        ;;
      flac)
        if [ "$CP_FLAC" -eq 1 ]; then
          target_path=$(get_target_path "$file" "$FLAC_DIR")
          mkdir -p "$target_path"
          if [ -e "${file%.*}.wav" ]; then
            log_info "Moving flac" "\"$file\" -> \"$target_path\""
            mv --update "$file" "$target_path"
          else
            log_info "Copying flac" "\"$file\" -> \"$target_path\""
            cp --update "$file" "$target_path"
          fi
          continue
        fi
        ;;
    esac

    # copy any file to IPOD_DIR and FLAC_DIR
    file_basename=$(basename "$file")
    if [ "$CP_IPOD" -eq 1 ]; then
      target_path=$(get_target_path "$file" "$IPOD_DIR")
      mkdir -p "$target_path"
      if [ ! -e "${target_path}${file_basename%.*}.*" ]; then
        log_info "Copying ipod" "\"$file\" -> \"$target_path\""
        cp --update "$file" "$target_path"
      fi
    fi
    if [ "$CP_FLAC" -eq 1 ]; then
      target_path=$(get_target_path "$file" "$FLAC_DIR")
      mkdir -p "$target_path"
      if [ ! -e "${target_path}${file_basename%.*}.*" ]; then
        log_info "Copying flac" "\"$file\" -> \"$target_path\""
        cp --update "$file" "$target_path"
      fi
    fi
  done
}

rip_cd() {
  log_info "Ripping CD to \"${SRC_DIR}${RIP_FOLDER}\" ..."

  ABCDE_CONF_FILE=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  write_abcde_conf
  printf "OUTPUTDIR=\"${SRC_DIR}${RIP_FOLDER}\"" >>"$ABCDE_CONF_FILE"

  abcde -c "$ABCDE_CONF_FILE"
  rip_status=$?
  [ "$rip_status" -ne 0 ] && { log_error "Error: CD rip failed"; exit 1; }

  log_success "CD ripped successfully!"
}

write_abcde_conf() {
  tee "$ABCDE_CONF_FILE" <<'EOF' >/dev/null
LOWDISK=y
EXTRAVERBOSE=2
EJECTCD=y
CDDBMETHOD=cddb
CDDBURL="http://gnudb.gnudb.org/~cddb/cddb.cgi"
CDDBCOPYLOCAL="y"
CDDBLOCALDIR="$HOME/.cddb"
CDDBLOCALRECURSIVE="y"
CDDBUSELOCAL="y"
CDROMREADERSYNTAX=cdparanoia
CDPARANOIA=cdparanoia
CDPARANOIAOPTS="--never-skip=40"
CDDISCID=cd-discid
ACTIONS=cddb,read,encode,move,clean
OUTPUTTYPE="wav"
OUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
ONETRACKOUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAONETRACKOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
PADTRACKS=y
mungefilename () { echo "$@" | sed -e 's/^\.*//' | tr -d ":><|*/\"'?[:cntrl:]"; }
EOF
}

cover_processor() {
  tmp_image=$(mktemp /tmp/mm_cover.XXXXXX.jpg)
  find "$SRC_DIR" \( -iname 'cover.png' -o -iname 'cover.jpg' -o -iname 'cover.jpeg' \) -type f \
  | while IFS= read -r file; do

    log_info "Creating cover" "\"$(dirname "$file")/cover_ipod.jpg\""
    magick "$file" -thumbnail "${COVER_DIM_IPOD}>" "$tmp_image"
    cp "$tmp_image" "$(dirname "$file")/cover_ipod.jpg"

    case "${file##*.}" in
      png|PNG)
        log_info "Converting cover" "\"$file\""
        magick "$file" -resize "${COVER_DIM}>" -strip -quality "$COVER_CONVERT_QUALITY" "$tmp_image"
        cp "$tmp_image" "$(dirname "$file")/cover.jpg"
        rm -f "$file"
        ;;
      jpg|JPG|jpeg|JPEG)
        log_info "Resizing cover" "\"$file\""
        magick_opts="-resize ${COVER_DIM}> -strip"
        [ "$(wc -c < "$file")" -gt 1048576 ] && magick_opts="$magick_opts -quality $COVER_CONVERT_QUALITY"
        magick "$file" $magick_opts "$tmp_image"
        cp --update "$tmp_image" "$file"
        ;;
    esac
  done
}

trap cleanup_tmp_files EXIT INT TERM
main "$@"
