#!/bin/zsh

# =======================
# ===  CONFIGURATION  ===
# =======================

setopt extendedglob nullglob

# --- COLORS ---
# Set the ANSI escape mode to color the output on the terminal. See link below:
# https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#color-codes
COLOR_RESET='\033[0m'    # reset mode
COLOR_SUCCESS='\033[32m' # green
COLOR_INFO='\033[33m'    # yellow
COLOR_ERROR='\033[31m'   # red

# --- ENCODERS ---
ENCODER_AAC="$HOME/.wine/drive_c/qaac/qaac.exe"
ENCODER_AAC_OPTIONS="--tvbr 100 --quality 2 --gapless-mode 2 --silent"
ENCODER_AAC_USE_WINE=0
ENCODER_FLAC="flac"
ENCODER_FLAC_OPTIONS="-V --best -j1 --silent"
ENCODER_WINE="WINEDEBUG=-all wine"

# --- OPTIONS ---
THREAD_NUM=$(getconf _NPROCESSORS_ONLN 2>/dev/null || print 1)
CONV_IPOD=1
CONV_FLAC=1
CP_IPOD=1
CP_FLAC=1
RIP_CD=0
RIP_MULTI_CD=0
RIP_CD_FOLDER="mm_cd_rip"
KEEP_VA=0
COVER_PROCESS=0
COVER_CONVERT_QUALITY=85
COVER_CROP=(-gravity center -crop 1:1 +repage)
COVER_DIM="1500x1500"
COVER_DIM_IPOD="200x200"

# --- GLOBAL VARIABLES ---
typeset _MKDIR_LAST_CREATED="" SRC_DIR="" IPOD_DIR="" FLAC_DIR=""

# ===================
# ===  FUNCTIONS  ===
# ===================

print_help() {
  cat <<EOF
Usage:
  musicmaid [options] <source> [ipod-dir] [flac-dir]

Arguments:
  source         Source directory with the files to be processed
  ipod-dir       Destination directory for AAC files (defaults to source)
  flac-dir       Destination directory for FLAC files (defaults to source)

Options:
  -h, --help              Show this help message and exit
  -r, --rip               Rip CD into "source/$RIP_CD_FOLDER" before operations
  -m, --rip-multi         Rip multiple CDs into "source/$RIP_CD_FOLDER" before
                          operations
  -c, --cover             Process cover images (resize, convert, compress)
  -v, --keep-va           Don't rename "Various Artists" to "Compilations"
  -i, --ipod              Skip AAC conversions
  -f, --flac              Skip FLAC conversions
  -p, --cp-ipod           Don't copy or move files to ipod-dir
  -l, --cp-flac           Don't copy or move files to flac-dir

Dependencies:
  GNU Parallel   Parallel file conversion
  abcde          CD ripper
  flac           FLAC encoder
  qaac           AAC encoder
  ImageMagick    Cover image processing
EOF
}

_print_color() {
  print -n "${1}${2}${COLOR_RESET}"; shift 2
  (( $# > 0 )) && print -n " $*"
  print
}

print_success() { _print_color "$COLOR_SUCCESS" "[SUCCESS]" "$@"; }
print_info() { _print_color "$COLOR_INFO" "[INFO]" "$@"; }
print_error() { { _print_color "$COLOR_ERROR" "[ERROR]" "$@"; } >&2; }

_cleanup_tmp_files() { rm -f /tmp/mm_abcde.* /tmp/mm_cover.* 2>/dev/null; }

# Caches the last created directory to avoid multiple mkdir calls for the same path.
# Usage: _mkdir_cache "directory"
_mkdir_cache() {
  [[ $1 != $_MKDIR_LAST_CREATED ]] && { mkdir -p "$1"; _MKDIR_LAST_CREATED=$1; }
}

_ask_mkdir() {
  print_info "Directory does not exist:" "$1"
  read -q "?Do you want to create it? [y/N] "
  local ans=$?
  print
  if (( ans == 0 )); then
    _mkdir_cache "$1" || { print_error "Can't create directory \"$1\""; exit 1; }
  else
    print_error "Missing or invalid directory \"$1\""
    exit 1
  fi
}

parse_parameters() {
  (( $# == 0 )) && { print_error "Too few arguments. Use '-h' or '--help' to see how to use this script"; exit 1; }

  local -a opt_help opt_ipod opt_flac opt_cp_ipod opt_cp_flac opt_rip opt_rip_multi opt_keep_va opt_cover
  zparseopts -D -F -- \
    h=opt_help       -help=opt_help \
    i=opt_ipod       -ipod=opt_ipod \
    f=opt_flac       -flac=opt_flac \
    p=opt_cp_ipod    -cp-ipod=opt_cp_ipod \
    l=opt_cp_flac    -cp-flac=opt_cp_flac \
    r=opt_rip        -rip=opt_rip \
    m=opt_rip_multi  -rip-multi=opt_rip_multi \
    v=opt_keep_va    -keep-va=opt_keep_va \
    c=opt_cover      -cover=opt_cover \
    2>/dev/null || { print_error "Unknown option: $1"; exit 1; }

  (( ${#opt_help} )) && { print_help; exit 0; }
  (( ${#opt_ipod} )) && CONV_IPOD=0
  (( ${#opt_flac} )) && CONV_FLAC=0
  (( ${#opt_cp_ipod} )) && CP_IPOD=0
  (( ${#opt_cp_flac} )) && CP_FLAC=0
  (( ${#opt_rip} )) && RIP_CD=1
  (( ${#opt_rip_multi} )) && RIP_MULTI_CD=1
  (( ${#opt_keep_va} )) && KEEP_VA=1
  (( ${#opt_cover} )) && COVER_PROCESS=1

  if (( $# > 0 )); then SRC_DIR=$1; shift; fi
  if (( $# > 0 && (CONV_IPOD || CP_IPOD) )); then IPOD_DIR=$1; shift; fi
  if (( $# > 0 && (CONV_FLAC || CP_FLAC) )); then FLAC_DIR=$1; shift; fi
  (( $# > 0 )) && { print_error "Too many arguments"; exit 1; }

  if (( CONV_IPOD || CONV_FLAC || CP_IPOD || CP_FLAC || RIP_CD || COVER_PROCESS )) && \
     [[ -z $SRC_DIR || ! -d $SRC_DIR ]]; then
    print_error "Missing or invalid source directory"
    exit 1
  fi
  SRC_DIR=$(realpath "$SRC_DIR")/

  IPOD_DIR=${IPOD_DIR:-$SRC_DIR}
  [[ ! -d $IPOD_DIR ]] && _ask_mkdir "$IPOD_DIR"
  IPOD_DIR=$(realpath "$IPOD_DIR")/

  FLAC_DIR=${FLAC_DIR:-$SRC_DIR}
  [[ ! -d $FLAC_DIR ]] && _ask_mkdir "$FLAC_DIR"
  FLAC_DIR=$(realpath "$FLAC_DIR")/

  [[ $SRC_DIR == $IPOD_DIR ]] && CP_IPOD=0
  [[ $SRC_DIR == $FLAC_DIR ]] && CP_FLAC=0
}

# Checks if a command is available. Returns 1 if at least one is missing, 0 otherwise.
# Variable names containing command paths are also supported.
# Usage: _check_dependency command [command ...]
_check_dependency() {
  local missing_dep=0 display_name item_to_check magic_bytes
  for cmd in "$@"; do
    display_name=$cmd
    item_to_check=${(P)cmd}
    if [[ -f $item_to_check ]]; then
      magic_bytes=$(head -c 2 "$item_to_check" 2>/dev/null)
      if [[ $magic_bytes == "MZ" ]]; then  # windows exe
        if ! command -v wine > /dev/null 2>&1; then
          print_error "wine is required by $item_to_check but is not installed"
          missing_dep=1
        fi
        display_name="${(U)display_name}_USE_WINE"
        typeset -g "$display_name=1"
      elif [[ ! -x $item_to_check ]]; then
        print_error "$item_to_check exists but is not an executable file"
        missing_dep=1
      fi
    elif ! command -v "$cmd" > /dev/null 2>&1 && \
         ! command -v "$item_to_check" > /dev/null 2>&1; then
      print_error "$cmd is not installed"
      missing_dep=1
    fi
  done
  return $missing_dep
}

# Returns target directory in 'base_directory/artist/album/' format.
# Usage: _get_target_path "file" "base_directory"
_get_target_path() {
  local file=$1 base_dir=$2
  local album=${file:h:t} artist=${file:h:h:t}
  if (( !KEEP_VA )) && [[ ${(L)artist} == "various artists" ]]; then
    artist="Compilations"
  fi

  local result=$base_dir
  [[ $artist != "." && $artist != "/" ]] && result+="${artist}/"
  [[ $album  != "." && $album  != "/" ]] && result+="${album}/"
  print -n "$result"
}

convert_ipod() {
  ! _check_dependency ENCODER_AAC parallel && { print_info "Skipping AAC conversion due to missing dependencies"; return 1; }
  
  export COLOR_INFO COLOR_RESET ENCODER_AAC ENCODER_AAC_OPTIONS ENCODER_AAC_USE_WINE ENCODER_WINE
  local target_path file
  for file in $SRC_DIR**/*.(#i)(wav|flac)(.); do
    [[ -e ${file:r}.m4a ]] && continue
    [[ ${(L)${file:e}} == "flac" && ( -e ${file:r}.wav || -e ${file:r}.WAV ) ]] && continue

    target_path=$(_get_target_path "$file" "$IPOD_DIR")
    _mkdir_cache "$target_path"
    printf '%s\0%s\0' "$target_path" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    dest_dir={1}
    file={2}
    printf '%b' "${COLOR_INFO}[AAC]${COLOR_RESET} Converting audio \"$file\"\n"
    if [ "$ENCODER_AAC_USE_WINE" -eq 1 ]; then
      '"$ENCODER_WINE"' "$ENCODER_AAC" '"$ENCODER_AAC_OPTIONS"' -d "$dest_dir" "$file"
    else
      "$ENCODER_AAC" '"$ENCODER_AAC_OPTIONS"' -d "$dest_dir" "$file"
    fi
  '
}

convert_flac() {
  ! _check_dependency ENCODER_FLAC parallel && { print_info "Skipping FLAC conversion due to missing dependencies"; return 1; }

  export COLOR_INFO COLOR_RESET ENCODER_FLAC ENCODER_FLAC_OPTIONS
  local target_path file
  for file in $SRC_DIR**/*.(#i)wav(.); do
    [[ -e ${file:r}.flac ]] && continue

    target_path=$(_get_target_path "$file" "$FLAC_DIR")
    _mkdir_cache "$target_path"
    printf '%s\0%s\0' "${target_path}${file:t:r}.flac" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    output_file={1}
    input_file={2}
    printf '%b' "${COLOR_INFO}[FLAC]${COLOR_RESET} Converting audio \"$input_file\"\n"
    "$ENCODER_FLAC" '"$ENCODER_FLAC_OPTIONS"' -o "$output_file" -- "$input_file"
  '
}

_copy_ipod() {
  local file=$1
  local target_path=$(_get_target_path "$file" "$IPOD_DIR")
  _mkdir_cache "$target_path"

  if [[ -e ${file:r}.wav  || -e ${file:r}.WAV || \
        -e ${file:r}.flac || -e ${file:r}.FLAC ]]; then
    print_info "Moving ipod" "\"$file\" -> \"$target_path\""
    mv "$file" "$target_path"
    return 0
  fi

  print_info "Copying ipod" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

_copy_flac() {
  local file=$1
  local target_path=$(_get_target_path "$file" "$FLAC_DIR")
  _mkdir_cache "$target_path"

  if [[ ${(L)${file:e}} == "flac" ]]; then
    if [[ -e ${file:r}.wav || -e ${file:r}.WAV ]]; then
      print_info "Moving flac" "\"$file\" -> \"$target_path\""
      mv "$file" "$target_path"
    else
      print_info "Copying flac" "\"$file\" -> \"$target_path\""
      cp "$file" "$target_path"
    fi
    return 0
  fi

  local target_file_basename="${target_path}${file:t:r}"
  local -a target_file_matches=( "${target_file_basename}".* )
  [[ -e ${file:r}.flac || -e ${file:r}.FLAC || ${#target_file_matches} -gt 0 ]] && return 0

  print_info "Copying flac" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

copy_files() {
  local file
  for file in $SRC_DIR**/*.(#i)(m4a|mp3|flac)(.); do
    (( CP_FLAC )) && _copy_flac "$file"
    if (( CP_IPOD )) && [[ -e $file && ${(L)${file:e}} != "flac" ]]; then
      _copy_ipod "$file"
    fi
  done
}

rip_cd() {
  ! _check_dependency abcde && { print_info "Skipping CD rip due to missing dependencies"; return 1; }
  local conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  write_abcde_conf "$conf_file"
  print -n "OUTPUTDIR=\"${SRC_DIR}${RIP_CD_FOLDER}\"" >> "$conf_file"

  print_info "Ripping CD to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  abcde -c "$conf_file"
  local rip_status=$?
  (( rip_status != 0 )) && { print_error "CD rip failed"; exit 1; }
  print_success "CD ripped successfully!"
}

rip_multi_cd() {
  ! _check_dependency abcde && { print_info "Skipping multi CD rip due to missing dependencies"; return 1; }
  local conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  write_abcde_conf "$conf_file"
  print -n "OUTPUTDIR=\"${SRC_DIR}${RIP_CD_FOLDER}\"" >> "$conf_file"

  print_info "Ripping CDs to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  while true; do
    abcde -c "$conf_file"
    local rip_status=$?
    (( rip_status != 0 )) && { print_error "CD rip failed"; exit 1; }
    print_success "CD ripped successfully!"
    read -q "?Do you want to rip another CD? [y/N] ";
    local ans=$?
    print
    (( ans != 0 )) && break
    read -sk 1 "?Insert next CD and press any key to continue..."
    print
  done
}

write_abcde_conf() {
  tee "$1" <<'EOF' >/dev/null
LOWDISK=y
EXTRAVERBOSE=2
EJECTCD=y
CDDBMETHOD=cddb
CDDBURL="http://gnudb.gnudb.org/~cddb/cddb.cgi"
CDDBCOPYLOCAL="y"
CDDBLOCALDIR="$HOME/.cddb"
CDDBLOCALRECURSIVE="y"
CDDBUSELOCAL="y"
CDROMREADERSYNTAX=cdparanoia
CDPARANOIA=cdparanoia
CDPARANOIAOPTS="--never-skip=40"
CDDISCID=cd-discid
ACTIONS=cddb,read,encode,move,clean
OUTPUTTYPE="wav"
OUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
ONETRACKOUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAONETRACKOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
PADTRACKS=y
mungefilename () { echo "$@" | sed -e 's/^\.*//' | tr -d ":><|*/\"'?[:cntrl:]"; }
EOF
}

cover_processor() {
  ! _check_dependency magick && { print_info "Skipping cover processing due to missing dependencies"; return 1; }
  local tmp_image=$(mktemp /tmp/mm_cover.XXXXXX.jpg)

  local file
  for file in $SRC_DIR/**/*(#i)cover.(png|jpg|jpeg|webp)(.); do
    if [[ ! -e ${file:r}_ipod.jpg ]]; then
      print_info "Creating cover" "\"${file:r}_ipod.jpg\""
      magick "$file" "${COVER_CROP[@]}" -thumbnail "${COVER_DIM_IPOD}>" "$tmp_image"
      cp "$tmp_image" "${file:r}_ipod.jpg"
    fi

    case ${(L)${file:e}} in
      png|webp)
        print_info "Converting cover" "\"$file\""
        magick "$file" "${COVER_CROP[@]}" -resize "${COVER_DIM}>" -strip -quality $COVER_CONVERT_QUALITY "$tmp_image"
        cp "$tmp_image" "${file:r}.jpg"
        rm -f "$file"
        ;;
      jpg|jpeg)
        print_info "Resizing cover" "\"$file\""
        local -a magick_opts=(-resize "${COVER_DIM}>" -strip)
        (( $(wc -c < "$file") > 1048576 )) && magick_opts+=(-quality $COVER_CONVERT_QUALITY)
        magick "$file" "${COVER_CROP[@]}" "${magick_opts[@]}" "$tmp_image"
        cp "$tmp_image" "$file"
        ;;
    esac
  done
}

# ==============
# ===  MAIN  ===
# ==============

trap _cleanup_tmp_files EXIT INT TERM
parse_parameters "$@"

(( RIP_CD )) && { rip_cd && print; }
(( RIP_MULTI_CD )) && { rip_multi_cd && print; }

(( CONV_IPOD || CONV_FLAC || CP_IPOD || CP_FLAC || COVER_PROCESS )) && print_info "Scanning directory..."

(( CONV_IPOD )) && { convert_ipod && print; } &
(( CONV_FLAC )) && { convert_flac && print; } &
wait

(( CP_IPOD || CP_FLAC )) && { copy_files && print; }
(( COVER_PROCESS )) && { cover_processor && print; }

print_success "All done!"
exit 0
