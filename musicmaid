#!/bin/sh

# =======================
# ===  CONFIGURATION  ===
# =======================

# --- COLORS ---
# Set the ANSI escape mode to color the output on the terminal. See link below:
# https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#color-codes
COLOR_RESET='\033[0m'    # reset mode
COLOR_SUCCESS='\033[32m' # green
COLOR_INFO='\033[33m'    # yellow
COLOR_ERROR='\033[31m'   # red

# --- ENCODERS ---
ENCODER_AAC="$HOME/.wine/drive_c/qaac/qaac.exe"
ENCODER_AAC_OPTIONS="--tvbr 100 --quality 2 --gapless-mode 2"
ENCODER_AAC_USE_WINE=0
ENCODER_FLAC="ffmpeg"
ENCODER_FLAC_GLOBAL_OPTIONS="-hide_banner -loglevel info -nostats -y"
ENCODER_FLAC_OPTIONS="-c:a flac -compression_level 12"
ENCODER_FLAC_USE_WINE=0
ENCODER_WINE="WINEDEBUG=-all wine"

# --- OPTIONS ---
THREAD_NUM=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
CONV_IPOD=1
CONV_FLAC=1
CP_IPOD=1
CP_FLAC=1
RIP_CD=0
RIP_MULTI_CD=0
RIP_CD_FOLDER="mm_cd_rip"
KEEP_VA=0
COVER_PROCESS=0
COVER_CONVERT_QUALITY=85
COVER_DIM="1500x1500"
COVER_DIM_IPOD="200x200"

# --- GLOBAL VARIABLES ---
_MKDIR_LAST_CREATED=""
SRC_DIR=""
IPOD_DIR=""
FLAC_DIR=""

# ===================
# ===  FUNCTIONS  ===
# ===================

print_help() {
  cat <<EOF
Usage:
  $(basename "$0") [options] <source> [ipod-dir] [flac-dir]

Arguments:
  source         Source directory with the files to be processed
  ipod-dir       Destination directory for AAC files (defaults to source)
  flac-dir       Destination directory for FLAC files (defaults to source)

Options:
  -h, --help              Show this help message and exit
  -r, --rip               Rip CD into "source/$RIP_CD_FOLDER" before operations
  -p, --rip-multi         Rip multiple CDs into "source/$RIP_CD_FOLDER" before
                          operations
  -c, --cover             Process cover images (resize, convert, compress)
  -v, --keep-va           Don't rename "Various Artists" to "Compilations"
  -i, --ipod              Skip AAC conversions
  -f, --flac              Skip FLAC conversions
  --cp-ipod               Don't copy or move files to ipod-dir
  --cp-flac               Don't copy or move files to flac-dir

Dependencies:
  GNU Parallel   Parallel file conversion
  abcde          CD ripper
  ffmpeg         FLAC encoder
  qaac           AAC encoder
  ImageMagick    Cover image processing
EOF
}

_log_color() {
  color="$1"
  shift
  printf '%b%s%b' "$color" "$1" "$COLOR_RESET"
  shift
  [ "$#" -gt 0 ] && printf ' %s' "$@"
  printf '\n'
}

log_success() { _log_color "$COLOR_SUCCESS" "$@"; }

log_info() { _log_color "$COLOR_INFO" "$@"; }

log_error() { { _log_color "$COLOR_ERROR" "$@"; } >&2; }

readc() {
  # Reads one character from user input and converts it to its ASCII representation.
  # Source: https://unix.stackexchange.com/a/464963
  # Usage: readc <variable-name>

  if [ -t 0 ]; then
    saved_tty_settings=$(stty -g)
    stty -icanon min 1 time 0 -echo
  fi
  eval "$1="
  while
    c=$(dd bs=1 count=1 2> /dev/null; echo .)
    c=${c%.}
    [ -n "$c" ] &&
      eval "$1=\${$1}"'$c
        [ "$(($(printf '%s' "${'"$1"'}" | wc -m)))" -eq 0 ]'; do
    continue
  done
  # get ascii representation of input
  input_clean=$(eval "printf '%s' \"\$$1\"" | od -An -v -t a | tr -d '[:space:]')
  eval "$1=\"$input_clean\""
  [ -t 0 ] && stty "$saved_tty_settings"
}

_cleanup_tmp_files() { rm -f /tmp/mm_abcde.* /tmp/mm_cover.* 2>/dev/null; }

_mkdir_cache() {
  # Caches the last created directory to avoid multiple mkdir calls for the same path.
  # Usage: _mkdir_cache "directory"

  [ "$1" != "$_MKDIR_LAST_CREATED" ] && { mkdir -p "$1"; _MKDIR_LAST_CREATED="$1"; }
}

_ask_mkdir() {
  log_info "Directory does not exist:" "$1"
  printf '%s' "Do you want to create it? [y/N] "
  readc ans && printf '\n'
  if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
    mkdir -p "$1" || { log_error "Error: can't create directory \"$1\""; exit 1; }
  else
    log_error "Error: missing or invalid directory \"$1\""
    exit 1
  fi
}

parse_parameters() {
  [ "$#" -eq 0 ] && { log_error "Error: too few arguments"; exit 1; }
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) print_help; exit 0 ;;
      -i|--ipod) CONV_IPOD=0; shift ;;
      -f|--flac) CONV_FLAC=0; shift ;;
      --cp-ipod) CP_IPOD=0; shift ;;
      --cp-flac) CP_FLAC=0; shift ;;
      -r|--rip) RIP_CD=1; shift ;;
      -p|--rip-multi) RIP_MULTI_CD=1; shift ;;
      -v|--keep-va) KEEP_VA=1; shift ;;
      -c|--cover) COVER_PROCESS=1; shift ;;
      -*|--*) log_error "Error: unknown option $1"; exit 1 ;;
      *) break ;;
    esac
  done

  while [ "$#" -gt 0 ]; do
    if [ -z "$SRC_DIR" ]; then SRC_DIR="$1"
    elif [ -z "$IPOD_DIR" ] && { [ "$CONV_IPOD" -eq 1 ] || [ "$CP_IPOD" -eq 1 ]; }; then IPOD_DIR="$1"
    elif [ -z "$FLAC_DIR" ] && { [ "$CONV_FLAC" -eq 1 ] || [ "$CP_FLAC" -eq 1 ]; }; then FLAC_DIR="$1"
    else { log_error "Error: too many arguments"; exit 1; }
    fi
    shift
  done

  if [ "$CONV_IPOD" -eq 1 ] || [ "$CONV_FLAC" -eq 1 ] || [ "$CP_IPOD" -eq 1 ] || [ "$CP_FLAC" -eq 1 ] \
  || [ "$RIP_CD" -eq 1 ] || [ "$COVER_PROCESS" -eq 1 ] && { [ -z "$SRC_DIR" ] || [ ! -d "$SRC_DIR" ]; }; then
    log_error "Error: missing or invalid source directory"
    exit 1
  fi
  SRC_DIR=$(realpath "$SRC_DIR")/

  IPOD_DIR=${IPOD_DIR:-$SRC_DIR}
  [ ! -d "$IPOD_DIR" ] && _ask_mkdir "$IPOD_DIR"
  IPOD_DIR=$(realpath "$IPOD_DIR")/

  FLAC_DIR=${FLAC_DIR:-$SRC_DIR}
  [ ! -d "$FLAC_DIR" ] && _ask_mkdir "$FLAC_DIR"
  FLAC_DIR=$(realpath "$FLAC_DIR")/

  [ "$SRC_DIR" = "$IPOD_DIR" ] && CP_IPOD=0
  [ "$SRC_DIR" = "$FLAC_DIR" ] && CP_FLAC=0
}

_check_dependency() {
  # Checks if a command is available. Returns 1 if at least one is missing, 0 otherwise.
  # Variable names containing command paths are also supported.
  # Usage: _check_dependency command [command ...]

  missing_dep=0
  for cmd in "$@"; do
    display_name="$cmd"
    item_to_check=""
    eval "item_to_check=\$$cmd"
    if [ -f "$item_to_check" ]; then
      if head -c 2 "$item_to_check" 2>/dev/null | grep -q '^MZ'; then
        if ! command -v wine >/dev/null 2>&1; then
          log_error "Error: wine is required by $item_to_check but is not installed"
          missing_dep=1
        fi
        display_name="$(echo "$display_name" | tr '[:lower:]' '[:upper:]')_USE_WINE"
        eval "$display_name=1"
      elif [ ! -x "$item_to_check" ]; then
        log_error "Error: $item_to_check exists but is not an executable file"
        missing_dep=1
      fi
    elif [ ! command -v "$cmd" >/dev/null 2>&1 ] || [ ! command -v "$item_to_check" >/dev/null 2>&1 ]; then
      log_error "Error: $cmd is not installed"
      missing_dep=1
    fi
  done
  return "$missing_dep"
}

_get_target_path() {
  # Returns target directory in 'base_directory/artist/album/' format.
  # Usage: _get_target_path "file" "base_directory"

  directory="${1%/*}"
  album="${directory##*/}"
  directory="${directory%/*}"
  artist="${directory##*/}"
  if [ "$KEEP_VA" -eq 0 ]; then
    case "$artist" in
      [Vv][Aa][Rr][Ii][Oo][Uu][Ss][\ ][Aa][Rr][Tt][Ii][Ss][Tt][Ss])
        artist="Compilations"
        ;;
    esac
  fi

  result="$2"
  [ "$artist" != "." ] && [ "$artist" != "/" ] && result="$result$artist/"
  [ "$album" != "." ] && [ "$album" != "/" ] && result="$result$album/"
  printf '%s' "$result"
}

convert_ipod() {
  ! _check_dependency ENCODER_AAC parallel && { log_info "Skipping AAC conversion due to missing dependencies"; return 1; }
  export COLOR_INFO COLOR_RESET ENCODER_AAC ENCODER_AAC_OPTIONS ENCODER_AAC_USE_WINE ENCODER_WINE
  find "$SRC_DIR" \( -iname "*.[Ww][Aa][Vv]" -o -iname "*.[Ff][Ll][Aa][Cc]" \) -type f \
  | while IFS= read -r file; do
    [ -e "${file%.*}.m4a" ] && continue
    case "${file##*.}" in
      [Ff][Ll][Aa][Cc]) [ -e "${file%.*}.wav" ] || [ -e "${file%.*}.WAV" ] && continue ;;
    esac

    target_path=$(_get_target_path "$file" "$IPOD_DIR")
    _mkdir_cache "$target_path"
    printf '%s\0%s\0' "$target_path" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    dest_dir={1}
    file={2}
    printf '%b' "${COLOR_INFO}Converting audio${COLOR_RESET} \"$file\"\n"
    if [ "$ENCODER_AAC_USE_WINE" -eq 1 ]; then
      '"$ENCODER_WINE"' "$ENCODER_AAC" '"$ENCODER_AAC_OPTIONS"' -d "$dest_dir" "$file"
    else
      "$ENCODER_AAC" '"$ENCODER_AAC_OPTIONS"' -d "$dest_dir" "$file"
    fi
  '
}

convert_flac() {
  ! _check_dependency ENCODER_FLAC parallel && { log_info "Skipping FLAC conversion due to missing dependencies"; return 1; }
  export COLOR_INFO COLOR_RESET ENCODER_FLAC ENCODER_FLAC_GLOBAL_OPTIONS ENCODER_FLAC_OPTIONS ENCODER_FLAC_USE_WINE ENCODER_WINE
  find "$SRC_DIR" -iname "*.[Ww][Aa][Vv]" -type f \
  | while IFS= read -r file; do
    [ -e "${file%.*}.flac" ] && continue

    target_path=$(_get_target_path "$file" "$FLAC_DIR")
    _mkdir_cache "$target_path"
    file_basename="${file##*/}"
    printf '%s\0%s\0' "$target_path${file_basename%.*}.flac" "$file"
  done | parallel -0 -N2 -j"$THREAD_NUM" --colsep '\0' '
    dest_dir={1}
    file={2}
    printf '%b' "${COLOR_INFO}Converting audio${COLOR_RESET} \"$file\"\n"
    if [ "$ENCODER_FLAC_USE_WINE" -eq 1 ]; then
      '"$ENCODER_WINE"' "$ENCODER_FLAC" '"$ENCODER_FLAC_GLOBAL_OPTIONS"' -i "$file" '"$ENCODER_FLAC_OPTIONS"' "$dest_dir"
    else
      "$ENCODER_FLAC" '"$ENCODER_FLAC_GLOBAL_OPTIONS"' -i "$file" '"$ENCODER_FLAC_OPTIONS"' "$dest_dir"
    fi
  '
}

_copy_ipod() {
  file="$1"
  target_path=$(_get_target_path "$file" "$IPOD_DIR")
  _mkdir_cache "$target_path"

  if [ -e "${file%.*}.wav" ] || [ -e "${file%.*}.WAV" ] || \
      [ -e "${file%.*}.flac" ] || [ -e "${file%.*}.FLAC" ]; then
    log_info "Moving ipod" "\"$file\" -> \"$target_path\""
    mv "$file" "$target_path"
    return 0
  fi

  log_info "Copying ipod" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

_copy_flac() {
  file="$1"
  target_path=$(_get_target_path "$file" "$FLAC_DIR")
  _mkdir_cache "$target_path"

  case "${file##*.}" in
    [fF][lL][aA][cC])
      if [ -e "${file%.*}.wav" ] || [ -e "${file%.*}.WAV" ]; then
        log_info "Moving flac" "\"$file\" -> \"$target_path\""
        mv "$file" "$target_path"
      else
        log_info "Copying flac" "\"$file\" -> \"$target_path\""
        cp "$file" "$target_path"
      fi
      return 0
      ;;
  esac

  target_file="${file##*/}"
  target_file="$target_path${target_file%.*}"
  [ -e "${file%.*}.flac" ] || [ -e "${file%.*}.FLAC" ] || ( set -- "$target_file".*; [ -e "$1" ] ) && return 0

  log_info "Copying flac" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

copy_files() {
  find "$SRC_DIR" \( -iname "*.m4a" -o -iname "*.mp3" -o -iname "*.flac" \) -type f \
  | while IFS= read -r file; do
    [ "$CP_FLAC" -eq 1 ] && _copy_flac "$file"
    if [ "$CP_IPOD" -eq 1 ] && [ -e "$file" ]; then
      case "${file##*.}" in
        [Ff][Ll][Aa][Cc]) continue ;;
        *) _copy_ipod "$file" ;;
      esac
    fi
  done
}

rip_cd() {
  ! _check_dependency abcde && { log_info "Skipping CD rip due to missing dependencies"; return 1; }
  conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  write_abcde_conf "$conf_file"
  printf '%s' "OUTPUTDIR=\"${SRC_DIR}${RIP_CD_FOLDER}\"" >>"$conf_file"

  log_info "Ripping CD to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  abcde -c "$conf_file"; rip_status=$?
  [ "$rip_status" -ne 0 ] && { log_error "Error: CD rip failed"; exit 1; }
  log_success "CD ripped successfully!"
}

rip_multi_cd() {
  ! _check_dependency abcde && { log_info "Skipping multi CD rip due to missing dependencies"; return 1; }
  conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  write_abcde_conf "$conf_file"
  printf '%s' "OUTPUTDIR=\"${SRC_DIR}${RIP_CD_FOLDER}\"" >>"$conf_file"

  log_info "Ripping CDs to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  while true; do
    abcde -c "$conf_file"; rip_status=$?
    [ "$rip_status" -ne 0 ] && { log_error "Error: CD rip failed"; exit 1; }
    log_success "CD ripped successfully!"
    printf '%s' "Do you want to rip another CD? [y/N] "
    readc ans && printf '\n'
    [ "$ans" != "y" ] && [ "$ans" != "Y" ] && break
    printf '%s' "Insert next CD and press any key to continue..."
    readc ans && printf '\n'
  done
}

write_abcde_conf() {
  tee "$1" <<'EOF' >/dev/null
LOWDISK=y
EXTRAVERBOSE=2
EJECTCD=y
CDDBMETHOD=cddb
CDDBURL="http://gnudb.gnudb.org/~cddb/cddb.cgi"
CDDBCOPYLOCAL="y"
CDDBLOCALDIR="$HOME/.cddb"
CDDBLOCALRECURSIVE="y"
CDDBUSELOCAL="y"
CDROMREADERSYNTAX=cdparanoia
CDPARANOIA=cdparanoia
CDPARANOIAOPTS="--never-skip=40"
CDDISCID=cd-discid
ACTIONS=cddb,read,encode,move,clean
OUTPUTTYPE="wav"
OUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
ONETRACKOUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAONETRACKOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
PADTRACKS=y
mungefilename () { echo "$@" | sed -e 's/^\.*//' | tr -d ":><|*/\"'?[:cntrl:]"; }
EOF
}

cover_processor() {
  ! _check_dependency magick && { log_info "Skipping cover processing due to missing dependencies"; return 1; }
  tmp_image=$(mktemp /tmp/mm_cover.XXXXXX.jpg)
  find "$SRC_DIR" \( -iname '*cover.[Pp][Nn][Gg]' -o -iname '*cover.[Jj][Pp][Gg]' -o -iname '*cover.[Jj][Pp][Ee][Gg]' \) -type f \
  | while IFS= read -r file; do
    if [ ! -e "${file%.*}_ipod.jpg" ]; then
      log_info "Creating cover" "\"${file%.*}_ipod.jpg\""
      magick "$file" -thumbnail "${COVER_DIM_IPOD}>" "$tmp_image"
      cp "$tmp_image" "${file%.*}_ipod.jpg"
    fi

    case "${file##*.}" in
      [Pp][Nn][Gg])
        log_info "Converting cover" "\"$file\""
        magick "$file" -resize "${COVER_DIM}>" -strip -quality $COVER_CONVERT_QUALITY "$tmp_image"
        cp "$tmp_image" "${file%.*}.jpg"
        rm -f "$file"
        ;;
      [Jj][Pp][Gg]|[Jj][Pp][Ee][Gg])
        log_info "Resizing cover" "\"$file\""
        magick_opts="-resize ${COVER_DIM}> -strip"
        [ "$(wc -c < "$file")" -gt 1048576 ] && magick_opts="$magick_opts -quality $COVER_CONVERT_QUALITY"
        magick "$file" $magick_opts "$tmp_image"
        cp "$tmp_image" "$file"
        ;;
    esac
  done
}

# ==============
# ===  MAIN  ===
# ==============

trap _cleanup_tmp_files EXIT INT TERM
parse_parameters "$@"

[ "$RIP_CD" -eq 1 ] && { rip_cd && printf '\n'; }
[ "$RIP_MULTI_CD" -eq 1 ] && { rip_multi_cd && printf '\n'; }

[ "$CONV_IPOD" -eq 1 ] || [ "$CONV_FLAC" -eq 1 ] || \
[ "$CP_FLAC" -eq 1 ] || [ "$CP_IPOD" -eq 1 ] || \
[ "$COVER_PROCESS" -eq 1 ] && log_info "Scanning directory..."

[ "$CONV_IPOD" -eq 1 ] && { convert_ipod && printf '\n'; }
[ "$CONV_FLAC" -eq 1 ] && { convert_flac && printf '\n'; }
[ "$CP_IPOD" -eq 1 ] || [ "$CP_FLAC" -eq 1 ] && { copy_files && printf '\n'; }
[ "$COVER_PROCESS" -eq 1 ] && { cover_processor && printf '\n'; }
log_success "All done!"
exit 0
