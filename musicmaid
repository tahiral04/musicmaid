#!/bin/zsh

# =======================
# ===  CONFIGURATION  ===
# =======================

setopt extendedglob nullglob

# --- COLORS ---
# Set the ANSI escape mode to color the output on the terminal. See link below:
# https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#color-codes
COLOR_RESET='\033[0m'    # reset mode
COLOR_SUCCESS='\033[32m' # green
COLOR_INFO='\033[33m'    # yellow
COLOR_ERROR='\033[31m'   # red

# --- OPTIONS ---
THREAD_NUM=$(getconf _NPROCESSORS_ONLN 2>/dev/null || print 1)
CONV_LOSSY=0
CONV_LOSSLESS=1
CP_LOSSY=0
CP_LOSSLESS=1
RIP_CD=0
RIP_MULTI_CD=0
RIP_CD_FOLDER="mm_cd_rip"
KEEP_VA=0
COVER_PROCESS=0
COVER_CONVERT_QUALITY=85
COVER_CROP=(-gravity center -crop 1:1 +repage)
COVER_DIM="1500x1500"
COVER_DIM_THUMB="200x200"
SILENT=0
USE_XARGS=0

# --- GLOBAL VARIABLES ---
typeset _MKDIR_LAST_CREATED="" SRC_DIR="" LOSSY_DIR="" LOSSLESS_DIR="" TMP_FILES=$(mktemp /tmp/mm_tmp_files.XXXXXX)

# ===================
# ===  FUNCTIONS  ===
# ===================

write_musicmaid_env() {
  tee "$1" <<'EOF' >/dev/null
# --- GENERAL CONFIGURATION ---
# List of lossy and lossless formats present in the user's collection.
# To add new formats just include them in the corresponding list.
# If converting to a new format with the encoders specified below, make sure
# to also add the new format's extension to the corresponding list below.

# !! DO NOT WRITE QUOTES OR DOTS !!
#   wrong: LIB_FORMAT_LOSSY=("mp3" .ogg)
#   right: LIB_FORMAT_LOSSY=(mp3 ogg)

LIB_FORMAT_LOSSY=(m4a mp3 opus)
LIB_FORMAT_LOSSLESS=(flac)


# --- ENCODERS CONFIGURATION ---
# Use the wildcards :output and :input in the options to specify the output and
# input file (or directory) paths respectively. musicmaid will replace them
# with the actual paths when running the encoders.

# lossy encoder
ENCODER_LOSSY="$HOME/.wine/drive_c/qaac/qaac.exe"
ENCODER_LOSSY_OPTIONS="--tvbr 100 --quality 2 --gapless-mode 2 --silent -d :output :input"
ENCODER_LOSSY_EXT="m4a" # encoder's output extension without dot

# lossless encoder
ENCODER_LOSSLESS="flac"
ENCODER_LOSSLESS_OPTIONS="-V --best -j1 --silent -o :output -- :input"
ENCODER_LOSSLESS_EXT="flac" # encoder's output extension without dot

# wine and its flags
ENCODER_WINE="WINEDEBUG=-all wine"
EOF
}

validate_env() {
  local error=0
  local required=(ENCODER_LOSSY ENCODER_LOSSY_OPTIONS ENCODER_LOSSY_EXT
                  ENCODER_LOSSLESS ENCODER_LOSSLESS_OPTIONS ENCODER_LOSSLESS_EXT
                  ENCODER_WINE)
  for var in $required; do
    [[ -z ${(P)var} ]] && { print_error "$var is not set in musicmaid.env"; error=1; }
  done
  (( ${#LIB_FORMAT_LOSSY} == 0 )) && { print_error "LIB_FORMAT_LOSSY is empty, check musicmaid.env"; error=1; }
  (( ${#LIB_FORMAT_LOSSLESS} == 0 )) && { print_error "LIB_FORMAT_LOSSLESS is empty, check musicmaid.env"; error=1; }
  (( error )) && exit 1
}

print_help() {
  cat <<EOF
Usage:
  musicmaid [options] <source> [lossy-dir] [lossless-dir]

Arguments:
  source         Source directory with the files to be processed
  lossy-dir      Destination directory for LOSSY files (defaults to source)
  lossless-dir   Destination directory for LOSSLESS files (defaults to source)

Options:
  -a, --lossy             Do LOSSY conversions
  -f, --lossless          Skip LOSSLESS conversions
  -A, --cp-lossy          Do copy or move files to lossy-dir
  -F, --cp-lossless       Don't copy or move files to lossless-dir
  -v, --keep-va           Don't rename "Various Artists" to "Compilations"
  -c, --cover             Process cover images (resize, convert, compress)
  -r, --rip               Rip CD into "source/$RIP_CD_FOLDER" before operations
  -m, --rip-multi         Rip multiple CDs into "source/$RIP_CD_FOLDER" before
                          operations
  -s, --silent            Suppress non-error output. Also uses xargs instead of
                          GNU Parallel for parallel processing
  -e, --env               Output default encoders configuration to
                          ~/.config/musicmaid.env and exit
  -h, --help              Show this help message and exit

Dependencies:
  GNU Parallel   Parallel file conversion
  abcde          CD ripper
  ImageMagick    Cover image processing
EOF
}

# Prints a colored message. Only the first message is colored, the others are
# printed as is.
# Usage: _print_color <color> <message> [<message> ...]
_print_color() {
  print -n "${1}${2}${COLOR_RESET}"; shift 2
  (( $# > 0 )) && print -n " $*"
  print
}

print_success() { (( !SILENT )) && _print_color "$COLOR_SUCCESS" "[OKI]" "$@"; }
print_info() { (( !SILENT )) && _print_color "$COLOR_INFO" "[INF]" "$@"; }
print_error() { { _print_color "$COLOR_ERROR" "[ERR]" "$@"; } >&2; }

add_tmp_file() { print "$1" >> "$TMP_FILES"; }
_cleanup_tmp_files() { xargs -I{} sh -c 'rm -f "{}"' < "$TMP_FILES"; rm -f "$TMP_FILES"; }

# Caches the last created directory to avoid multiple mkdir calls for the same path.
# Usage: mkdir_cache "directory"
mkdir_cache() { [[ $1 != $_MKDIR_LAST_CREATED ]] && { mkdir -p "$1"; _MKDIR_LAST_CREATED=$1; } }

ask_mkdir() {
  if (( SILENT )); then
    print_error "Directory \"$1\" does not exist"
    exit 1
  fi
  print_info "Directory does not exist:" "$1"
  read -q "?Do you want to create it? [y/N] "
  local ans=$?
  print
  if (( ans == 0 )); then
    mkdir_cache "$1" || { print_error "Can't create directory \"$1\""; exit 1; }
  else
    print_error "Missing or invalid directory \"$1\""
    exit 1
  fi
}

parse_parameters() {
  (( $# == 0 )) && { print_error "Too few arguments. Use '-h' or '--help' to see how to use this script"; exit 1; }

  local -a opt_help opt_lossy opt_lossless opt_cp_lossy opt_cp_lossless opt_rip opt_rip_multi opt_keep_va opt_cover opt_silent opt_env
  zparseopts -D -F -- \
    h=opt_help        -help=opt_help \
    a=opt_lossy       -lossy=opt_lossy \
    f=opt_lossless    -lossless=opt_lossless \
    A=opt_cp_lossy    -cp-lossy=opt_cp_lossy \
    F=opt_cp_lossless -cp-lossless=opt_cp_lossless \
    r=opt_rip         -rip=opt_rip \
    m=opt_rip_multi   -rip-multi=opt_rip_multi \
    v=opt_keep_va     -keep-va=opt_keep_va \
    c=opt_cover       -cover=opt_cover \
    s=opt_silent      -silent=opt_silent \
    e=opt_env         -env=opt_env \
    2>/dev/null || { print_error "Unknown option: $1"; exit 1; }

  (( ${#opt_help} )) && { print_help; exit 0; }
  (( ${#opt_lossy} )) && CONV_LOSSY=1
  (( ${#opt_lossless} )) && CONV_LOSSLESS=0
  (( ${#opt_cp_lossy} )) && CP_LOSSY=1
  (( ${#opt_cp_lossless} )) && CP_LOSSLESS=0
  (( ${#opt_rip} )) && RIP_CD=1
  (( ${#opt_rip_multi} )) && RIP_MULTI_CD=1
  (( ${#opt_keep_va} )) && KEEP_VA=1
  (( ${#opt_cover} )) && COVER_PROCESS=1
  (( ${#opt_silent} )) && { SILENT=1; USE_XARGS=1; }
  if (( ${#opt_env} )); then
    write_musicmaid_env "$HOME/.config/musicmaid.env"
    print_info "Created default encoders configuration at \"$HOME/.config/musicmaid.env\""
    exit 0
  fi

  (( $# > 0 )) && { SRC_DIR=$1; shift; }
  (( $# > 0 && (CONV_LOSSY || CP_LOSSY) )) && { LOSSY_DIR=$1; shift; }
  (( $# > 0 && (CONV_LOSSLESS || CP_LOSSLESS) )) && { LOSSLESS_DIR=$1; shift; }
  (( $# > 0 )) && { print_error "Too many arguments"; exit 1; }

  if (( CONV_LOSSY || CONV_LOSSLESS || CP_LOSSY || CP_LOSSLESS || RIP_CD || COVER_PROCESS )) && \
     [[ -z $SRC_DIR || ! -d $SRC_DIR ]]; then
    print_error "Missing or invalid source directory"
    exit 1
  fi
  SRC_DIR=$(realpath "$SRC_DIR")/

  LOSSY_DIR=${LOSSY_DIR:-$SRC_DIR}
  [[ ! -d $LOSSY_DIR ]] && ask_mkdir "$LOSSY_DIR"
  LOSSY_DIR=$(realpath "$LOSSY_DIR")/

  LOSSLESS_DIR=${LOSSLESS_DIR:-$SRC_DIR}
  [[ ! -d $LOSSLESS_DIR ]] && ask_mkdir "$LOSSLESS_DIR"
  LOSSLESS_DIR=$(realpath "$LOSSLESS_DIR")/

  [[ $SRC_DIR == $LOSSY_DIR ]] && CP_LOSSY=0
  [[ $SRC_DIR == $LOSSLESS_DIR ]] && CP_LOSSLESS=0

  if (( CONV_LOSSY && CONV_LOSSLESS )); then
    THREAD_NUM=$(( THREAD_NUM / 2 ))
    (( THREAD_NUM < 1 )) && THREAD_NUM=1
  fi
}

# Checks if a command is available. Returns 1 if at least one is missing, 0 otherwise.
# Variable names containing command paths are also supported.
# Usage: check_dependency command [command ...]
check_dependency() {
  local missing_dep=0 display_name item_to_check magic_bytes
  for cmd in "$@"; do
    display_name=$cmd
    item_to_check=${(P)cmd}
    if [[ -f $item_to_check ]]; then
      magic_bytes=$(head -c 2 "$item_to_check" 2>/dev/null)
      if [[ $magic_bytes == "MZ" ]]; then  # windows exe
        if ! command -v wine > /dev/null 2>&1; then
          print_error "wine is required by $item_to_check but is not installed"
          missing_dep=1
        fi
        display_name="${(U)display_name}_USE_WINE"
        typeset -g "$display_name=1"
      elif [[ ! -x $item_to_check ]]; then
        print_error "$item_to_check exists but is not an executable file"
        missing_dep=1
      fi
    elif ! command -v "$cmd" > /dev/null 2>&1 && \
         ! command -v "$item_to_check" > /dev/null 2>&1; then
      print_error "$cmd is not installed"
      missing_dep=1
    fi
  done
  return $missing_dep
}

# Returns target directory in 'base_directory/artist/album/' format.
# Usage: get_target_path "file" "base_directory"
get_target_path() {
  local file=$1 base_dir=$2 rip_dir="${RIP_CD_FOLDER}/"
  local rel_dir=${${file:h}#$SRC_DIR}
  rel_dir=${rel_dir#$rip_dir}

  if (( !KEEP_VA )) && [[ -n "$rel_dir" ]]; then
    local artist=${rel_dir%%/*}
    [[ ${(L)artist} == "various artists" ]] && rel_dir="Compilations${rel_dir#$artist}"
  fi

  local result=$base_dir
  [[ -n $rel_dir ]] && result+="${rel_dir}/"
  print -n "$result"
}

# Usage: convert_parallel <file_list> <encoder> <encoder_options> <encoder_use_wine> <is_lossy>
convert_parallel() {
  local file_list=$1
  export enc=$2 enc_opts=$3 enc_use_wine=${4:-0} is_lossy=${5:-0}
  export COLOR_INFO COLOR_RESET
  parallel -0 -N2 -j"$THREAD_NUM" '
    output={1}
    input={2}
    output_esc=$(printf "%q" "$output")
    input_esc=$(printf "%q" "$input")
    opts="${enc_opts//:output/$output_esc}"
    opts="${opts//:input/$input_esc}"
    if [ "$is_lossy" -eq 1 ]; then
      printf "%b" "${COLOR_INFO}[CNV]${COLOR_RESET} Lossy: \"$input\"\n"
    else
      printf "%b" "${COLOR_INFO}[CNV]${COLOR_RESET} Lossless: \"$input\"\n"
    fi
    if [ "$enc_use_wine" -eq 1 ]; then
      eval "'"$ENCODER_WINE"' \"$enc\" $opts"
    else
      eval "\"$enc\" $opts"
    fi
  ' < "$file_list"
}

# Usage: convert_xargs <file_list> <encoder> <encoder_options> <encoder_use_wine>
convert_xargs() {
  local file_list=$1
  export enc=$2 enc_opts=$3 enc_use_wine=${4:-0}
  xargs -0 -a "$file_list" -n2 -P"$THREAD_NUM" sh -c '
    output={1}
    input={2}
    output=$(printf "%q" "$output")
    input=$(printf "%q" "$input")
    opts="${enc_opts//:output/$output}"
    opts="${opts//:input/$input}"
    if [ "$enc_use_wine" -eq 1 ]; then
      eval "'"$ENCODER_WINE"' \"$enc\" $opts" >/dev/null
    else
      eval "\"$enc\" $opts" >/dev/null
    fi
  ' _
}

convert_lossy() {
  ! check_dependency ENCODER_LOSSY && { print_info "Skipping LOSSY conversion due to missing dependencies"; return 1; }
  ! check_dependency parallel && { print_info "GNU Parallel not found. Falling back to xargs..."; USE_XARGS=1; }
  
  local target_path file file_list=$(mktemp /tmp/mm_lossy.XXXXXX)
  add_tmp_file "$file_list"
  local ext_pattern="(wav|${(j:|:)LIB_FORMAT_LOSSLESS})"

  for file in $SRC_DIR**/*.(#i)${~ext_pattern}(.); do
    local lossy_found=0
    for ext in $LIB_FORMAT_LOSSY; do
      [[ -e ${file:r}.$ext || -e ${file:r}.${(U)ext} ]] && { lossy_found=1; break; }
    done
    [[ -e ${file:r}.$ENCODER_LOSSY_EXT || $lossy_found -eq 1 ]] && continue

    # do not convert file if it is in lossless format but the wav file exist, we want to convert the wav file
    (( ${LIB_FORMAT_LOSSLESS[(Ie)${(L)${file:e}}]} )) && [[ -e ${file:r}.wav || -e ${file:r}.WAV ]] && continue

    target_path=$(get_target_path "$file" "$LOSSY_DIR")
    mkdir_cache "$target_path"
    printf '%s\0%s\0' "$target_path" "$file" >> "$file_list"
  done


  if (( USE_XARGS )); then
    convert_xargs "$file_list" "$ENCODER_LOSSY" "$ENCODER_LOSSY_OPTIONS" "$ENCODER_LOSSY_USE_WINE"
  else
    convert_parallel "$file_list" "$ENCODER_LOSSY" "$ENCODER_LOSSY_OPTIONS" "$ENCODER_LOSSY_USE_WINE" "1"
  fi
}

convert_lossless() {
  ! check_dependency ENCODER_LOSSLESS && { print_info "Skipping LOSSLESS conversion due to missing dependencies"; return 1; }
  ! check_dependency parallel && { print_info "GNU Parallel not found. Falling back to xargs..."; USE_XARGS=1; }

  local target_path file file_list=$(mktemp /tmp/mm_lossless.XXXXXX)
  add_tmp_file "$file_list"

  for file in $SRC_DIR**/*.(#i)wav(.); do
    local lossless_found=0
    for ext in $LIB_FORMAT_LOSSLESS; do
      [[ -e ${file:r}.$ext || -e ${file:r}.${(U)ext} ]] && { lossless_found=1; break; }
    done

    [[ -e ${file:r}.$ENCODER_LOSSLESS_EXT || $lossless_found -eq 1 ]] && continue

    target_path=$(get_target_path "$file" "$LOSSLESS_DIR")
    mkdir_cache "$target_path"
    printf '%s\0%s\0' "${target_path}${file:t:r}.${ENCODER_LOSSLESS_EXT}" "$file" >> "$file_list"
  done

  if (( USE_XARGS )); then
    convert_xargs "$file_list" "$ENCODER_LOSSLESS" "$ENCODER_LOSSLESS_OPTIONS" "$ENCODER_LOSSLESS_USE_WINE"
  else
    convert_parallel "$file_list" "$ENCODER_LOSSLESS" "$ENCODER_LOSSLESS_OPTIONS" "$ENCODER_LOSSLESS_USE_WINE"
  fi
}

_copy_lossy() {
  local file=$1
  local target_path=$(get_target_path "$file" "$LOSSY_DIR")
  mkdir_cache "$target_path"

  local lossless_found=0
  for ext in $LIB_FORMAT_LOSSLESS; do
    [[ -e ${file:r}.$ext || -e ${file:r}.${(U)ext} ]] && { lossless_found=1; break; }
  done

  if [[ -e ${file:r}.wav  || -e ${file:r}.WAV ]] || (( lossless_found )); then
    print_info "Moving lossy" "\"$file\" -> \"$target_path\""
    mv "$file" "$target_path"
    return 0
  fi

  print_info "Copying lossy" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

_copy_lossless() {
  local file=$1
  local target_path=$(get_target_path "$file" "$LOSSLESS_DIR")
  mkdir_cache "$target_path"

  if (( ${LIB_FORMAT_LOSSLESS[(Ie)${(L)${file:e}}]} )) || [[ ${(L)${file:e}} == ${ENCODER_LOSSLESS_EXT} ]]; then
    if [[ -e ${file:r}.wav || -e ${file:r}.WAV ]]; then
      print_info "Moving lossless" "\"$file\" -> \"$target_path\""
      mv "$file" "$target_path"
    else
      print_info "Copying lossless" "\"$file\" -> \"$target_path\""
      cp "$file" "$target_path"
    fi
    return 0
  fi

  local target_file_basename="${target_path}${file:t:r}"
  local -a target_file_matches=( "${target_file_basename}".* )
  local lossless_found=0
  for ext in $LIB_FORMAT_LOSSLESS; do
    [[ -e ${file:r}.$ext || -e ${file:r}.${(U)ext} ]] && { lossless_found=1; break; }
  done

  (( lossless_found || ${#target_file_matches} > 0 )) && return 0

  print_info "Copying lossless" "\"$file\" -> \"$target_path\""
  cp "$file" "$target_path"
}

copy_files() {
  local file
  local ext_pattern="(${(j:|:)LIB_FORMAT_LOSSY}|${(j:|:)LIB_FORMAT_LOSSLESS})"

  for file in $SRC_DIR**/*.(#i)${~ext_pattern}(.); do
    (( CP_LOSSLESS )) && _copy_lossless "$file"
    if (( CP_LOSSY )) && (( ${LIB_FORMAT_LOSSY[(Ie)${(L)${file:e}}]} )); then
      _copy_lossy "$file"
    fi
  done
}

rip_cd() {
  ! check_dependency abcde && { print_info "Skipping CD rip due to missing dependencies"; return 1; }
  local conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  add_tmp_file "$conf_file"
  write_abcde_conf "$conf_file"

  print_info "Ripping CD to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  abcde -c "$conf_file"
  local rip_status=$?
  (( rip_status != 0 )) && { print_error "CD rip failed"; exit 1; }
  print_success "CD ripped successfully!"
}

rip_multi_cd() {
  ! check_dependency abcde && { print_info "Skipping multi CD rip due to missing dependencies"; return 1; }
  local conf_file=$(mktemp /tmp/mm_abcde.XXXXXX.conf)
  add_tmp_file "$conf_file"
  write_abcde_conf "$conf_file"

  print_info "Ripping CDs to \"${SRC_DIR}${RIP_CD_FOLDER}\" ..."
  while true; do
    abcde -c "$conf_file"
    local rip_status=$?
    (( rip_status != 0 )) && { print_error "CD rip failed"; exit 1; }
    print_success "CD ripped successfully!"
    read -q "?Do you want to rip another CD? [y/N] ";
    local ans=$?
    print
    (( ans != 0 )) && break
    read -sk 1 "?Insert next CD and press any key to continue..."
    print
  done
}

write_abcde_conf() {
  tee "$1" <<'EOF' >/dev/null
LOWDISK=y
EJECTCD=y
CDDBMETHOD=cddb
CDDBURL="http://gnudb.gnudb.org/~cddb/cddb.cgi"
CDDBCOPYLOCAL="y"
CDDBLOCALDIR="$HOME/.cddb"
CDDBLOCALRECURSIVE="y"
CDDBUSELOCAL="y"
CDROMREADERSYNTAX=cdparanoia
CDPARANOIA=cdparanoia
CDPARANOIAOPTS="--never-skip=40"
CDDISCID=cd-discid
ACTIONS=cddb,read,encode,move,clean
OUTPUTTYPE="wav"
OUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
ONETRACKOUTPUTFORMAT='${ARTISTFILE}/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
VAONETRACKOUTPUTFORMAT='Various Artists/${ALBUMFILE}/${TRACKNUM} ${TRACKFILE}'
PADTRACKS=y
mungefilename () { echo "$@" | sed -e 's/^\.*//' | tr -d ":><|*/\"'?[:cntrl:]"; }
EOF
  print "OUTPUTDIR=\"${SRC_DIR}${RIP_CD_FOLDER}\"" >> "$1"
  if (( SILENT )); then
    print "EXTRAVERBOSE=0" >> "$1"
  else
    print "EXTRAVERBOSE=1" >> "$1"
  fi
}

cover_processor() {
  ! check_dependency magick && { print_info "Skipping cover processing due to missing dependencies"; return 1; }
  local tmp_image=$(mktemp /tmp/mm_cover.XXXXXX.jpg)
  add_tmp_file "$tmp_image"

  local file
  for file in $SRC_DIR**/*(#i)cover.(png|jpg|jpeg|webp)(.); do
    if [[ ! -e ${file:r}_thumb.jpg ]]; then
      print_info "Creating thumbnail" "\"${file:r}_thumb.jpg\""
      magick "$file" "${COVER_CROP[@]}" -thumbnail "${COVER_DIM_THUMB}>" "$tmp_image"
      cp "$tmp_image" "${file:r}_thumb.jpg"
    fi

    case ${(L)${file:e}} in
      png|webp)
        print_info "Converting cover" "\"$file\""
        magick "$file" "${COVER_CROP[@]}" -resize "${COVER_DIM}>" -strip -quality $COVER_CONVERT_QUALITY "$tmp_image"
        cp "$tmp_image" "${file:r}.jpg"
        rm -f "$file"
        ;;
      jpg|jpeg)
        print_info "Resizing cover" "\"$file\""
        local -a magick_opts=(-resize "${COVER_DIM}>" -strip)
        (( $(wc -c < "$file") > 1048576 )) && magick_opts+=(-quality $COVER_CONVERT_QUALITY)
        magick "$file" "${COVER_CROP[@]}" "${magick_opts[@]}" "$tmp_image"
        cp "$tmp_image" "$file"
        ;;
    esac
  done
}

# ==============
# ===  MAIN  ===
# ==============

trap _cleanup_tmp_files EXIT INT TERM
parse_parameters "$@"

if [[ ! -f "$HOME/.config/musicmaid.env" ]]; then
  write_musicmaid_env "$HOME/.config/musicmaid.env"
  print_info "Created default encoders configuration at \"$HOME/.config/musicmaid.env\""
fi
source "$HOME/.config/musicmaid.env"
validate_env

(( RIP_CD )) && { rip_cd; (( !SILENT )) && print; }
(( RIP_MULTI_CD )) && { rip_multi_cd; (( !SILENT )) && print; }

(( CONV_LOSSY || CONV_LOSSLESS || CP_LOSSY || CP_LOSSLESS || COVER_PROCESS )) && print_info "Scanning directory..."

(( CONV_LOSSY )) && convert_lossy &
(( CONV_LOSSLESS )) && convert_lossless &
wait

(( CP_LOSSY || CP_LOSSLESS )) && { copy_files; (( !SILENT )) && print; }
(( COVER_PROCESS )) && { cover_processor; (( !SILENT )) && print; }

print_success "All done!"
exit 0
